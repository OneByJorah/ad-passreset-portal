# ad-passreset-portal — copy to .env and fill in real values
PORT=8080

# ── Password provider ─────────────────────────────────────────────────────────
# Default: debug provider in the Development environment (boots without AD —
# LOCAL TRIAL ONLY). Production: ASPNETCORE_ENVIRONMENT=Production,
# WEB_DEBUG_PROVIDER=false, AD_PROVIDER_MODE=Ldap, fill all AD_* values.
ASPNETCORE_ENVIRONMENT=Development
WEB_DEBUG_PROVIDER=true
AD_PROVIDER_MODE=Auto

# ── Active Directory (LDAP) ───────────────────────────────────────────────────
AD_LDAP_SERVER=ldap.example.local
AD_LDAP_PORT=636
AD_LDAP_USE_SSL=true
AD_BASE_DN=DC=example,DC=local
AD_SERVICE_ACCOUNT_DN=CN=svc-passreset,DC=example,DC=local
AD_SERVICE_PASSWORD=change-me
AD_SERVICE_ACCOUNT=svc-passreset

# ── SMTP relay ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.example.local
SMTP_PORT=587
SMTP_FROM=passreset@yourdomain.com

# ── Health checks ─────────────────────────────────────────────────────────────
# With the debug provider or before AD/SMTP are reachable, keep probes disabled
# so /api/health reports healthy. Set both to false once AD and SMTP are real.
HEALTH_DISABLE_AD_PROBE=true
HEALTH_DISABLE_SMTP_PROBE=true
